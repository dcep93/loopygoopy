{
  "name": "Loopy Goopy",
  "description": "Practice any part of a video with clear beat counts, repeat loops, and adjustable speed.",
  "version": "5.0.11",
  "icons": {
    "16": "loopy_goopy_full.png",
    "48": "loopy_goopy_full.png",
    "128": "loopy_goopy_128.png"
  },
  "background": {
    "service_worker": "runtime/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.instagram.com/*",
        "https://drive.google.com/drive/folders/19o1Pno4TV6tP8t1r8hisTKar-x1GMAQs*",
        "file:///*"
      ],
      "js": [
        "app/src/app/LoopyGoopy/contentScript.js"
      ]
    },
    {
      "matches": [
        "https://youtube.googleapis.com/embed/*",
        "https://www.youtube.com/embed/*",
        "https://www.youtube-nocookie.com/embed/*"
      ],
      "all_frames": true,
      "js": [
        "app/src/app/LoopyGoopy/contentScript.js"
      ]
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "runtime/practice.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "app/src/app/LoopyGoopy/pagePlaybackBridge.js"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.googleapis.com/*",
        "https://www.youtube-nocookie.com/*",
        "https://www.instagram.com/*",
        "file:///*"
      ]
    },
    {
      "resources": [
        "runtime/ComicRelief-Regular.ttf"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "app/build/index.html",
    "default_icon": "loopy_goopy_full.png"
  },
  "manifest_version": 3,
  "permissions": [
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*"
  ],
  "minimum_chrome_version": "120"
}
